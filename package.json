{
  "name": "asesmen-sumatif-terpadu",
  "version": "1.0.0",
  "private": true,
  "description": "Asesmen Sumatif (ASAS, ASAT, ASAJ) — aplikasi statis, buka index.html langsung di browser.",
  "scripts": {
    "build:css": "tailwindcss -c build/tailwind.config.js -i build/tailwind.input.css -o css/tailwind.css --minify",
    "build:sw": "node build/build-sw.js",
    "build:icons": "node build/make-icons.js",
    "build": "npm run build:css && npm run build:sw",
    "test": "node build/build-sw.js --check && node build/smoke-test.js",
    "build:deb": "sh build/make-deb.sh"
  },
  "devDependencies": {
    "playwright-core": "^1.48.0",
    "tailwindcss": "^3.4.0"
  }
}
